{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter \"./artifacts/api-server\" build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/manifest", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/admin/:path*", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/cron/morning-watchlist",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/payday-pulse",
      "schedule": "47 * * * *"
    },
    {
      "path": "/api/cron/engagement-loop",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/plaid-sync-all",
      "schedule": "17 */4 * * *"
    },
    {
      "path": "/api/cron/plaid-webhook-backfill",
      "schedule": "23 6 * * *"
    },
    {
      "path": "/api/cron/settle-projection-history",
      "schedule": "11 5 1 * *"
    },
    {
      "path": "/api/cron/record-projection-history",
      "schedule": "33 5 * * *"
    },
    {
      "path": "/api/cron/induce-skills",
      "schedule": "47 4 * * 0"
    },
    {
      "path": "/api/cron/curate-skills",
      "schedule": "11 5 * * 0"
    }
  ]
}
